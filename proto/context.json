{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yasuomaidana/dendrite-rag-rs/proto/context.json",
  "title": "context",
  "description": "Token-budgeted context pack: hybrid hits expanded through the symbol graph, PageRank-weighted, de-duplicated and merged.",
  "params": {
    "type": "object",
    "required": [
      "root",
      "query"
    ],
    "properties": {
      "root": {
        "type": "string",
        "description": "Project directory"
      },
      "query": {
        "type": "string"
      },
      "token_budget": {
        "type": "integer",
        "minimum": 1,
        "default": 4000
      },
      "corpus": {
        "enum": [
          "all",
          "code",
          "docs"
        ],
        "default": "all",
        "description": "Corpora searched: all (both in one ranking), code, or docs (Markdown, txt, rst)"
      },
      "detail": {
        "enum": [
          "auto",
          "full",
          "map"
        ],
        "default": "auto",
        "description": "auto: text of retrieved spans, outlines of graph neighbours; full: text of every span; map: outlines only"
      }
    }
  },
  "result": {
    "type": "object",
    "required": [
      "spans",
      "tokens"
    ],
    "properties": {
      "spans": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/hit"
        }
      },
      "tokens": {
        "type": "integer"
      },
      "abstained": {
        "type": "boolean",
        "description": "Protocol 1.8: the reranker found nothing likely to answer ([rerank] abstain), so spans is empty. Absent when false"
      },
      "timings": {
        "type": "object",
        "description": "Milliseconds spent per stage",
        "properties": {
          "lexical_ms": {
            "type": "integer",
            "minimum": 0
          },
          "dense_ms": {
            "type": "integer",
            "minimum": 0
          },
          "symbol_ms": {
            "type": "integer",
            "minimum": 0
          },
          "rerank_ms": {
            "type": "integer",
            "minimum": 0
          },
          "expand_ms": {
            "type": "integer",
            "minimum": 0
          },
          "total_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "hit": {
      "type": "object",
      "required": [
        "chunk_id",
        "path",
        "start_line",
        "end_line",
        "scope",
        "score",
        "content"
      ],
      "properties": {
        "chunk_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score": {
          "type": "number"
        },
        "content": {
          "type": "string"
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other files holding the same text, dropped from the results"
        },
        "outline": {
          "type": "boolean",
          "description": "content is the span's outline (doc comment or heading and declaration); fetch the text with chunks.get"
        }
      }
    }
  }
}
